        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"acao\": \"registrar_turnos\", \"params\": { \"numero\": $('Montar mensagem').first().json.numero, \"texto_agente\": $('Montar mensagem').first().json.mensagem, \"agente\": \"nutridora\", \"papel\": \"lead\", \"nome\": $('Lead Novo').first().json.body.nome, \"proativo\": true, \"execucao_n8n\": $execution.id } } }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "9aPJmxbhrMSs5qYJ",
          "name": "MAG - X-Agente-Token"
        }
      },
      "onError": "continueRegularOutput"
    }
