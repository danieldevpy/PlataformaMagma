    {
      "id": "25d5d5f8-7d6f-4205-b04c-df6f30b3393b",
      "name": "Registrar toque (T+0)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        896,
        -80
