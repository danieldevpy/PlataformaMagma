            {
              "id": "c1",
              "leftValue": "={{ $json.body.whatsapp }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.body.whatsapp }}",
              "rightValue": "={{ $env.MAGMA_NUMEROS_TESTE_REGEX }}",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.body.utm_source }}",
              "rightValue": "whatsapp",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-tem-whatsapp",
      "name": "Deve mandar boas-vindas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
