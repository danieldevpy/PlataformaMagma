    {
      "id": "avisar-montar",
      "name": "Avisar: montar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Monta o texto final do aviso de handoff (spec 025-T10).\n//\n// O QUE veio da IA é só o `mensagem` (por que está escalando). O COMO\n// responder é fixo aqui, não no prompt: pedido do Daniel de que o gestor\n// continue a conversa pelo WhatsApp da Magma, e não pelo número pessoal\n// dele — senão o contato passa a ter duas vias abertas com a escola, o\n// histórico da spec 021 registra metade da conversa, e se o gestor sair\n// da empresa o relacionamento vai junto no aparelho dele.\n//\n// `numero_contato` vem do CONTEXTO da execução (fieldValue no tool), não\n// da IA — o gestor precisa do número certo pra achar a conversa, e\n// identificador redigitado por modelo é a classe de erro da spec 023.\nconst body = $json.body || {};\nconst numero = String(body.numero_contato || '').trim();\n\nconst partes = [String(body.mensagem || '').trim()];\nif (numero) {\n  // Linha própria = copiável de um toque no celular.\n  partes.push('Contato: ' + numero);\n}\npartes.push(\n  '⚠️ Responda pelo WhatsApp da Magma, não por este número — assim a ' +\n  'pessoa fala com um canal só.'\n);\n\nreturn [{ json: { textoAviso: partes.join('\\n\\n') } }];"
      }
    }
